---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Magic Clicker - Juego">
	<section class="game-screen">
		<div class="top-area">
			<div class="main-clicker">
				<div class="click-label">Clicks</div>
				<button id="clickBtn" class="big-click-btn">0</button>
				<button id="invokeBtn" class="invoke-btn">INVOCAR</button>
				<div class="invoke-cost">Costo: <span id="invokeCost">100</span> clicks</div>
			</div>
			<aside class="magic-panel">
				<div class="panel-head">
					<h2>Tus magias</h2>
					<span id="multiplierLabel">Multiplicador total: 1.0x</span>
				</div>
				<div class="magic-grid" id="magicGrid">
					<!-- Magias se renderizan aquí -->
				</div>
			</aside>
		</div>

		<div class="inventory-panel">
			<div class="inventory-head">
				<h2>Inventario de magias</h2>
				<p>Equipa una magia para aumentar el multiplicador.</p>
			</div>
			<div class="inventory-grid" id="inventoryGrid"></div>
		</div>
	</section>
	<style>
		.game-screen {
			padding: 2rem;
			color: #fff;
			min-height: calc(100vh - 57px);
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}
		.top-area {
			display: grid;
			grid-template-columns: 1.5fr 1fr;
			gap: 2rem;
			align-items: stretch;
		}
		.main-clicker {
			background: rgba(255,255,255,0.04);
			border: 1px solid rgba(201,168,76,0.25);
			padding: 2rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1.5rem;
			min-height: 360px;
			position: relative;
		}
		.click-label {
			font-family: 'Cinzel', serif;
			color: #fff;
			letter-spacing: 0.2em;
			font-size: 0.85rem;
			text-transform: uppercase;
		}
		.big-click-btn {
			width: 100%;
			max-width: 420px;
			aspect-ratio: 1 / 1;
			border-radius: 50%;
			border: 2px solid #c9a84c;
			background: radial-gradient(circle at top, rgba(201,168,76,0.2), transparent 55%), #121212;
			color: #f5f5f5;
			font-size: 3rem;
			font-family: 'Cinzel', serif;
			cursor: pointer;
			box-shadow: 0 0 40px rgba(201,168,76,0.2);
			transition: transform 0.2s, box-shadow 0.2s;
		}
		.big-click-btn:hover { transform: scale(1.02); }
		.invoke-btn {
			width: 100%;
			max-width: 300px;
			border: 1px solid #c9a84c;
			background: #c9a84c;
			color: #050505;
			font-family: 'Cinzel', serif;
			letter-spacing: 0.2em;
			padding: 1rem 1.25rem;
			cursor: pointer;
			text-transform: uppercase;
		}
		.invoke-cost {
			color: #fff;
			font-size: 0.95rem;
			text-transform: uppercase;
			letter-spacing: 0.12em;
		}
		.magic-panel {
			background: rgba(255,255,255,0.03);
			border: 1px solid rgba(201,168,76,0.2);
			padding: 1.5rem;
			display: flex;
			flex-direction: column;
			gap: 1rem;
			min-height: 360px;
		}
		.panel-head {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}
		.panel-head h2 {
			font-family: 'Cinzel', serif;
			margin: 0;
			font-size: 1.25rem;
			color: #fff;
		}
		.panel-head span {
			color: #fff;
			font-size: 0.95rem;
		}
		.magic-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 0.9rem;
			flex: 1;
		}
		.magic-card,
		.inventory-card {
			background: rgba(255,255,255,0.05);
			border: 1px solid rgba(255,255,255,0.08);
			padding: 1rem;
			border-radius: 16px;
			display: grid;
			gap: 0.5rem;
		}
		.magic-card h3,
		.inventory-card h3 {
			font-family: 'Cinzel', serif;
			margin: 0;
			font-size: 1rem;
			color: #fff;
		}
		.magic-card p,
		.inventory-card p {
			margin: 0;
			color: #fff;
			font-size: 0.9rem;
			line-height: 1.4;
		}
		.rarity {
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: #e0c27a;
		}
		.status-row {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
			flex-wrap: wrap;
		}
		.inventory-panel {
			background: rgba(255,255,255,0.03);
			border: 1px solid rgba(201,168,76,0.2);
			padding: 1.5rem;
			border-radius: 24px;
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
		.inventory-head h2 {
			font-family: 'Cinzel', serif;
			font-size: 1.25rem;
			margin: 0;
			color: #fff;
		}
		.inventory-head p {
			margin: 0;
			color: #fff;
		}
		.inventory-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
		}
		.equip-btn {
			border: 1px solid #c9a84c;
			background: transparent;
			color: #fff;
			padding: 0.7rem 0.9rem;
			font-family: 'Cinzel', serif;
			letter-spacing: 0.08em;
			cursor: pointer;
			width: fit-content;
			justify-self: start;
		}
		.equip-btn.active {
			background: #c9a84c;
			color: #050505;
		}
		.inventory-card .rarity {
			justify-self: end;
		}
		@media (max-width: 900px) {
			.top-area { grid-template-columns: 1fr; }
			.inventory-grid { grid-template-columns: 1fr 1fr; }
		}
		@media (max-width: 640px) {
			.inventory-grid { grid-template-columns: 1fr; }
			.main-clicker { min-height: auto; }
		}
	</style>
</Layout>

<script>
	// Catálogo base de magias (id 1..4)
	const masterSpells = [
		{ id: 1, name: 'Chispa Común', description: 'Aumenta ligeramente tus clicks.', rarity: 'Comun', multiplier: 1.05 },
		{ id: 2, name: 'Rayo Raro', description: 'Multiplica tus clicks de forma notable.', rarity: 'Raro', multiplier: 1.15 },
		{ id: 3, name: 'Fulgor Épico', description: 'Potencia poderosa para clicks.', rarity: 'Epico', multiplier: 1.25 },
		{ id: 4, name: 'Llama Legendaria', description: 'Magia suprema con gran multiplicador.', rarity: 'Legendario', multiplier: 1.5 }
	]

	// userSpells guarda las magias del usuario: { id, equipped }
	function loadUserSpells() {
		try {
			return JSON.parse(localStorage.getItem('userSpells')) || []
		} catch (e) { return [] }
	}
	function saveUserSpells(arr) { localStorage.setItem('userSpells', JSON.stringify(arr)) }

	let userSpells = loadUserSpells()
	let clicks = 0
	const invokeCost = 100

	const clickBtn = document.getElementById('clickBtn')
	const invokeBtn = document.getElementById('invokeBtn')
	const invokeCostLabel = document.getElementById('invokeCost')
	const magicGrid = document.getElementById('magicGrid')
	const inventoryGrid = document.getElementById('inventoryGrid')
	const multiplierLabel = document.getElementById('multiplierLabel')

	function ownedSpells() {
		return userSpells.map(us => {
			const info = masterSpells.find(m => m.id === us.id)
			return { ...info, equipped: !!us.equipped }
		})
	}

	function getTotalMultiplier() {
		return ownedSpells().filter(s => s && s.equipped).reduce((total, spell) => total * (spell.multiplier || 1), 1)
	}

	function isLoggedIn() { return Boolean(localStorage.getItem('token') || localStorage.getItem('magicClickerUser')) }

	function updateDisplay() {
		clickBtn.textContent = Math.floor(clicks)
		invokeCostLabel.textContent = invokeCost
		multiplierLabel.textContent = `Multiplicador total: ${getTotalMultiplier().toFixed(2)}x`
		renderMagicCards()
		renderInventoryCards()
	}

	function renderMagicCards() {
		const equipped = ownedSpells().filter(s => s && s.equipped)
		magicGrid.innerHTML = ''
		if (!equipped.length) return // no mostrar nada si no tenés magias equipadas
		equipped.forEach(spell => {
			const card = document.createElement('article')
			card.className = 'magic-card'
			card.innerHTML = `
				<div class="status-row">
					<h3>${spell.name}</h3>
					<span class="rarity">${spell.rarity}</span>
				</div>
				<p>${spell.description}</p>
			`
			magicGrid.appendChild(card)
		})
	}

	function renderInventoryCards() {
		const owned = ownedSpells()
		inventoryGrid.innerHTML = ''
		if (!owned.length) {
			inventoryGrid.innerHTML = '<p style="color:#fff;">No tenés magias en el inventario.</p>'
			return
		}
		owned.forEach(spell => {
			const card = document.createElement('article')
			card.className = 'inventory-card'
			card.innerHTML = `
				<div class="status-row">
					<h3>${spell.name}</h3>
					<span class="rarity">${spell.rarity}</span>
				</div>
				<p>${spell.description}</p>
				<button class="equip-btn ${spell.equipped ? 'active' : ''}" data-id="${spell.id}">
					${spell.equipped ? 'EQUIPADA' : 'EQUIPAR'}
				</button>
			`
			inventoryGrid.appendChild(card)
		})
		inventoryGrid.querySelectorAll('.equip-btn').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = Number(e.currentTarget.dataset.id)
				const idx = userSpells.findIndex(us => us.id === id)
				if (idx >= 0) {
					userSpells[idx].equipped = !userSpells[idx].equipped
				}
				saveUserSpells(userSpells)
				updateDisplay()
			})
		})
	}

	clickBtn.addEventListener('click', () => {
		if (!isLoggedIn()) { window.location.href = '/login'; return }
		clicks += getTotalMultiplier()
		updateDisplay()
	})

	// Probabilidades: comun 60%, raro 25%, epico 10%, legendario 5%
	function rollSpellId() {
		const r = Math.random() * 100
		if (r < 60) return 1
		if (r < 85) return 2
		if (r < 95) return 3
		return 4
	}

	invokeBtn.addEventListener('click', () => {
		if (!isLoggedIn()) { window.location.href = '/login'; return }
		if (clicks < invokeCost) return
		clicks -= invokeCost
		const id = rollSpellId()
		const owned = userSpells.some(us => us.id === id)
		if (owned) {
			alert('Ya tenés esa magia.');
		} else {
			userSpells.push({ id, equipped: false })
			saveUserSpells(userSpells)
			alert('¡Has conseguido una nueva magia!')
		}
		updateDisplay()
	})

	// Inicializar display
	updateDisplay()
</script>
