---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Magic Clicker">

  <section class="hero">

    <h1 class="title">
      MAGIC CLICKER
    </h1>

    <div class="divider"></div>

    <p class="subtitle">
      Acumula energía, desbloquea magias
      y crea la build más poderosa.
    </p>

    <a href="/login" class="start-btn">
      COMENZAR
    </a>

  </section>

</Layout>

<style>

  .hero {
    height: calc(100vh - 140px);

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 1rem;
  }

  .title {
    font-size: 4rem;

    color: #f5f5f5;

    letter-spacing: 3px;

    font-weight: normal;

    margin-bottom: 1.5rem;
  }

  .divider {
    width: 220px;
    height: 1px;

    background: #b8923f;

    margin-bottom: 2rem;
  }

  .subtitle {
    color: #9a9a9a;

    font-size: 1.1rem;

    line-height: 1.7;

    max-width: 500px;

    margin-bottom: 3rem;
  }

  .start-btn {
    padding: 0.9rem 3rem;

    border: 1px solid #b8923f;

    color: #b8923f;

    text-decoration: none;

    font-size: 1rem;

    letter-spacing: 2px;

    transition: 0.2s;
  }

  .start-btn:hover {
    background: #b8923f;

    color: black;
  }

</style>