---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Magic Clicker">

  <section class="hero">

    <h1 class="title">
      MAGIC CLICKER
    </h1>

    <div class="divider"></div>

    <p class="subtitle">
      Acumula energía, desbloquea magias
      y crea la build más poderosa.
    </p>

    <a href="/login" class="start-btn">
      COMENZAR
    </a>

  </section>

</Layout>

<style>
.hero {
  height: calc(100vh - 57px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem;
  overflow: hidden;
}

  .title {
    font-family: 'Cinzel', serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: #c9a84c;
    letter-spacing: 0.12em;
    text-shadow: 0 0 30px rgba(201,168,76,0.3);
    margin-bottom: 1rem;
  }

  .divider {
    width: 220px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #c9a84c, transparent);
    margin-bottom: 1.5rem;
  }

  .subtitle {
    font-family: 'Crimson Text', serif;
    font-style: italic;
    font-size: 1.1rem;
    color: #b0a080;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2.5rem;
  }

  .start-btn {
    display: inline-block;
    padding: 0.9rem 3rem;
    border: 1px solid #c9a84c;
    color: #c9a84c;
    text-decoration: none;
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    transition: background 0.3s, color 0.3s;
  }

  .start-btn:hover {
    background: #c9a84c;
    color: #050505;
  }
</style>